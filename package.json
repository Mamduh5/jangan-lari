{
  "name": "jangan-lari",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:menu": "playwright test tests/e2e/menu-flow.spec.ts",
    "test:e2e:special": "playwright test tests/e2e/special-attacks.spec.ts",
    "test:e2e:hud": "playwright test tests/e2e/mobile-hud.spec.ts",
    "test:e2e:aim": "playwright test tests/e2e/mobile-aim.spec.ts",
    "test:e2e:controls": "playwright test tests/e2e/mobile-controls.spec.ts",
    "test:e2e:mobile-alpha-ui": "playwright test tests/e2e/mobile-alpha-ui.spec.ts",
    "test:e2e:upgrade-exhaustion": "playwright test tests/e2e/mobile-upgrade-exhaustion.spec.ts",
    "test:e2e:neutral-shapes": "playwright test tests/e2e/gameplay-bot.spec.ts -g \"neutral shapes\"",
    "test:e2e:stat-allocation": "playwright test tests/e2e/gameplay-bot.spec.ts -g \"stat allocation\"",
    "test:e2e:class-branching": "playwright test tests/e2e/gameplay-bot.spec.ts -g \"class branching\"",
    "test:e2e:leaderboard": "playwright test tests/e2e/local-leaderboard.spec.ts",
    "test:e2e:mobile-layout": "playwright test tests/e2e/mobile-layout.spec.ts",
    "test:e2e:smoke": "playwright test tests/e2e/menu-flow.spec.ts tests/e2e/special-attacks.spec.ts tests/e2e/mobile-hud.spec.ts",
    "test:all": "npm run test:unit && npm run test:e2e",
    "android:add": "cap add android",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:build": "npm run android:sync && cap build android",
    "apk:dev": "npm run android:sync && cd android && gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.5",
    "@capacitor/core": "^7.6.5",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.5",
    "@playwright/test": "^1.59.1",
    "jsdom": "^29.0.2",
    "typescript": "^5.8.3",
    "vite": "^7.1.0",
    "vitest": "^4.1.3"
  }
}
